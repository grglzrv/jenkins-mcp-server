# Legacy-core variant of the integration Jenkins image.
#
# The default Dockerfile installs the newest plugins, which track the newest
# core. On an older core that fails with "requires a greater version of
# Jenkins": current workflow-multibranch and friends demand 2.504.3, so a
# 2.504.1 controller cannot install them.
#
# This variant points the installer at the update centre for the core's own
# release line, which serves plugin versions built for that core.
#
# Kept separate on purpose: the default suite must not change behaviour.
ARG JENKINS_IMAGE=jenkins/jenkins:2.504.1-jdk21
FROM ${JENKINS_IMAGE}
USER root
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*
COPY plugins.txt /usr/share/jenkins/ref/plugins.txt

# Empty derives the line from the core version, 2.504.1 -> 2.504.
ARG JENKINS_UC_LINE=""
# Jenkins publishes per-line update centres, but the path differs by release
# type: an LTS line lives at stable-<line>, weeklies at <line>. Guessing wrong
# gives a 404 from the resolver, so try each candidate and keep the first that
# resolves, falling back to the default update centre.
RUN set -u; \
    VER="${JENKINS_VERSION:-}"; \
    LINE="${JENKINS_UC_LINE:-}"; \
    if [ -z "$LINE" ] && [ -n "$VER" ]; then LINE="$(echo "$VER" | cut -d. -f1,2)"; fi; \
    echo "core=${VER:-unknown} line=${LINE:-none}"; \
    OK=0; \
    for UC in \
        "${LINE:+https://updates.jenkins.io/stable-${LINE}}" \
        "${LINE:+https://updates.jenkins.io/${LINE}}" \
        "https://updates.jenkins.io/stable" \
        "https://updates.jenkins.io"; do \
      [ -z "$UC" ] && continue; \
      echo "=== trying update centre: $UC ==="; \
      if JENKINS_UC="$UC" jenkins-plugin-cli \
           --plugin-file /usr/share/jenkins/ref/plugins.txt; then \
        echo "=== resolved plugins from $UC ==="; OK=1; break; \
      fi; \
      echo "=== $UC did not work, trying the next ===" >&2; \
      rm -rf /usr/share/jenkins/ref/plugins/*.jpi /usr/share/jenkins/ref/plugins/*.jpi.pinned 2>/dev/null || true; \
    done; \
    if [ "$OK" -ne 1 ]; then echo "no update centre could resolve the plugin set" >&2; exit 1; fi

COPY casc/jenkins.yaml /usr/share/jenkins/ref/casc/jenkins.yaml
COPY entrypoint-tls.sh /usr/local/bin/entrypoint-tls.sh
RUN chmod +x /usr/local/bin/entrypoint-tls.sh
USER jenkins
ENTRYPOINT ["/usr/local/bin/entrypoint-tls.sh"]
