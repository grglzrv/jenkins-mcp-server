# Legacy-core variant of the integration Jenkins image.
#
# The default Dockerfile installs the newest plugins, which track the newest
# core. On an older core that fails with "requires a greater version of
# Jenkins": current workflow-multibranch and friends demand 2.504.3, so a
# 2.504.1 controller cannot install them.
#
# This variant points the installer at the update centre for the core's own
# release line, which serves plugin versions built for that core.
#
# Kept separate on purpose: the default suite must not change behaviour.
ARG JENKINS_IMAGE=jenkins/jenkins:2.504.1-jdk21
FROM ${JENKINS_IMAGE}
USER root
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*
COPY plugins.txt /usr/share/jenkins/ref/plugins.txt

# Empty derives the line from the core version, 2.504.1 -> 2.504.
ARG JENKINS_UC_LINE=""
RUN set -eu; \
    VER="${JENKINS_VERSION:-}"; \
    LINE="${JENKINS_UC_LINE:-}"; \
    if [ -z "$LINE" ] && [ -n "$VER" ]; then LINE="$(echo "$VER" | cut -d. -f1,2)"; fi; \
    echo "core=${VER:-unknown} line=${LINE:-default}"; \
    if [ -n "$LINE" ]; then \
      export JENKINS_UC="https://updates.jenkins.io/${LINE}"; \
      echo "JENKINS_UC=$JENKINS_UC"; \
    fi; \
    jenkins-plugin-cli --verbose --plugin-file /usr/share/jenkins/ref/plugins.txt

COPY casc/jenkins.yaml /usr/share/jenkins/ref/casc/jenkins.yaml
COPY entrypoint-tls.sh /usr/local/bin/entrypoint-tls.sh
RUN chmod +x /usr/local/bin/entrypoint-tls.sh
USER jenkins
ENTRYPOINT ["/usr/local/bin/entrypoint-tls.sh"]
