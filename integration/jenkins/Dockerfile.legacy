# Legacy-core variant of the integration Jenkins image.
#
# Two problems make an older controller untestable with the default image:
#
#   1. Unpinned plugins resolve to the newest release, which now requires a
#      newer core. workflow-multibranch demands 2.504.3, so a 2.504.1 controller
#      cannot install it. plugins-legacy.txt pins the versions that controller
#      actually runs, and --latest false settles dependencies on the minimum
#      each pinned plugin requires rather than the newest available.
#
#   2. The default image bootstraps with Configuration as Code, which is not
#      installed everywhere. This variant uses init.groovy.d, which is core
#      only and needs no plugin at all.
ARG JENKINS_IMAGE=jenkins/jenkins:2.504.1-jdk21
FROM ${JENKINS_IMAGE}
USER root
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*

COPY plugins-legacy.txt /usr/share/jenkins/ref/plugins.txt
RUN set -eu; \
    echo "core=${JENKINS_VERSION:-unknown}"; \
    jenkins-plugin-cli --latest false \
      --plugin-file /usr/share/jenkins/ref/plugins.txt; \
    echo "=== installed ==="; ls -1 /usr/share/jenkins/ref/plugins/ | sed 's/\.jpi$//' | sort

COPY init.groovy.d/ /usr/share/jenkins/ref/init.groovy.d/
COPY entrypoint-tls.sh /usr/local/bin/entrypoint-tls.sh
RUN chmod +x /usr/local/bin/entrypoint-tls.sh
USER jenkins
# No CASC_JENKINS_CONFIG here: bootstrapping happens in init.groovy.d.
ENTRYPOINT ["/usr/local/bin/entrypoint-tls.sh"]
