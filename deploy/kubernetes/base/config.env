# Replace with the full MagicDNS name of the Tailscale Service defined for Jenkins.
JENKINS_URL=https://jenkins.example-tailnet.ts.net
JENKINS_VERIFY_TLS=true
JENKINS_TIMEOUT_SECONDS=30
JENKINS_MAX_RETRIES=3
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_PATH=/mcp
MCP_HEALTH_HOST=0.0.0.0
MCP_HEALTH_PORT=8081
MCP_READ_ONLY=false
MCP_ALLOW_JOB_WRITE=true
MCP_ALLOW_BUILD_WRITE=true
MCP_ALLOW_NODE_WRITE=false
MCP_ALLOW_ADMIN_REQUEST=false
MCP_ALLOWED_JOBS=AI/*,Platform/*
MCP_MAX_LOG_BYTES=1000000
# Audit records are always emitted to stdout. This optional file is on an emptyDir volume.
MCP_AUDIT_LOG_PATH=/data/audit.jsonl
