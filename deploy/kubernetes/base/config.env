# Replace with the full MagicDNS name of the Tailscale Service defined for Jenkins.
# Replace with your Jenkins base URL, including any path prefix.
JENKINS_URL=https://jenkins.example.com
# Verify the certificate Jenkins presents. Leave enabled: disabling it accepts
# any certificate on a connection carrying a Jenkins API token.
JENKINS_VERIFY_TLS=true
# Optional. Only needed when Jenkins uses a private or self-signed CA; a
# publicly issued certificate (Let's Encrypt, a commercial CA, Tailscale) is
# validated by the container's trust store. Mount the CA and point at it:
#   JENKINS_CA_BUNDLE=/certs/ca.crt
JENKINS_TIMEOUT_SECONDS=30
JENKINS_MAX_RETRIES=3
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_PATH=/mcp
MCP_HEALTH_HOST=0.0.0.0
MCP_HEALTH_PORT=8081
MCP_READ_ONLY=false
MCP_ALLOW_JOB_WRITE=true
MCP_ALLOW_BUILD_WRITE=true
MCP_ALLOW_NODE_WRITE=false
MCP_ALLOW_ADMIN_REQUEST=false
# Destructive (irreversible) actions. MCP_ALLOW_DESTRUCTIVE is the master switch;
# each action also needs its own flag and the category flag above.
MCP_ALLOW_DESTRUCTIVE=false
# Job deletion cannot be undone, so it stays opt-in even with job writes enabled.
MCP_ALLOW_JOB_DELETE=false
MCP_ALLOW_JOB_UPDATE=true
# Aborts running builds and cancels queued items. Does not affect triggering.
MCP_ALLOW_BUILD_STOP=true
MCP_ALLOWED_JOBS=AI/*,Platform/*
MCP_MAX_LOG_BYTES=1000000
# Audit records are emitted to stdout for collection. File logging is omitted
# because the application does not rotate the file.
