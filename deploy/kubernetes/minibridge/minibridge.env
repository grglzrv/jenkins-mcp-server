# minibridge proxy configuration. These are read by the entrypoint in the
# -minibridge image and passed to the Rego policer as REGO_POLICY_RUNTIME_*.

# Client-facing Minibridge listeners. /mcp is MCP 2025-03-26 Streamable HTTP;
# the Jenkins child uses a private stdio pipe and binds no socket.
MINIBRIDGE_MODE=aio
MINIBRIDGE_LISTEN=:8000
MINIBRIDGE_HEALTH_LISTEN=:8080
MINIBRIDGE_ENDPOINT_MCP=/mcp
MINIBRIDGE_MCP_USE_TEMPDIR=true
# false logs a violation and lets the traffic through instead of blocking.
MINIBRIDGE_POLICER_ENFORCE=true

# Tool and capability policy. Empty means every tool is allowed.
# Groups: @read @write @destructive @admin @all
# Exclude only the irreversible tools:
TOOLS_DENY=@destructive
# A non-empty allow list becomes a strict allowlist, e.g. TOOLS_ALLOW=@read
TOOLS_ALLOW=
# Deny whole MCP capabilities by method name, e.g. resources/read
METHODS_DENY=

# Heuristic content guardrails, space separated. Empty disables all of them.
GUARDRAILS=covert-instruction-detection sensitive-pattern-detection shadowing-pattern-detection schema-misuse-prevention cross-origin-tool-access secrets-redaction

# Optional shared secret checked against the Authorization header. Leave empty
# to disable. Supply it from a Secret rather than here if you enable it.
# BASIC_AUTH_SECRET=
