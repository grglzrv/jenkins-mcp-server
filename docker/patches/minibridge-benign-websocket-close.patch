@@ -46,0 +47,12 @@ type wsBackend struct {
+func isBenignWebSocketClose(err error) bool {
+	if err == nil || errors.Is(err, net.ErrClosed) {
+		return true
+	}
+
+	message := err.Error()
+	return strings.HasSuffix(message, "websocket: close 1000 (normal)") ||
+		strings.HasSuffix(message, "websocket: close 1001 (going away)") ||
+		strings.HasSuffix(message, "websocket: close 1005 (no status)") ||
+		strings.HasSuffix(message, "websocket: close 1006 (abnormal closure): unexpected EOF")
+}
