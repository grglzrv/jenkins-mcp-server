# syntax=docker/dockerfile:1.7
#
# Hardened variant: the Jenkins MCP server behind Acuvity's minibridge, which
# applies the Rego guardrail policy in docker/policy.rego to every MCP request
# and response.
#
# Build from the repository root:
#   docker build -f docker/Dockerfile.minibridge -t jenkins-mcp-server:minibridge .
#
# The plain Dockerfile at the repo root remains the default image; this one is
# published separately (tag suffix -minibridge) for deployments that want the
# proxy in the path.
ARG PYTHON_IMAGE=python:3.12-slim-bookworm

# Minibridge 0.8.0 misclassifies its own local WebSocket shutdown as an error
# ("use of closed network connection"). Build the exact released commit with a
# narrow, reviewable backport until upstream publishes the fix. The source
# archive is content-pinned and the patched backend unit tests run before the
# binary is copied into the runtime image.
FROM --platform=$BUILDPLATFORM golang:1.25-alpine3.21 AS minibridge
ARG MINIBRIDGE_VERSION=0.8.0
ARG MINIBRIDGE_COMMIT=eea393407f60b2972ee065bcbc6fc49c6df03709
ARG MINIBRIDGE_SOURCE_SHA256=901b402bb848af91c060bfd6b6b5445de8785a136f577c9fd0130edb0ca52273
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
RUN apk add --no-cache ca-certificates curl git patch \
 && curl -fsSL --retry 4 --retry-delay 2 --retry-all-errors \
      -o /tmp/minibridge.tar.gz \
      "https://github.com/acuvity/minibridge/archive/${MINIBRIDGE_COMMIT}.tar.gz" \
 && echo "${MINIBRIDGE_SOURCE_SHA256}  /tmp/minibridge.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/minibridge.tar.gz --strip-components=1
COPY docker/patches/minibridge-benign-websocket-close.patch /tmp/minibridge.patch
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    patch -p1 < /tmp/minibridge.patch \
 && go test -mod=readonly -vet=off ./pkgs/backend \
 && CGO_ENABLED=0 GOOS="${TARGETOS:-linux}" GOARCH="${TARGETARCH:-amd64}" \
      go build -mod=readonly -trimpath \
      -ldflags="-w -s \
        -X go.acuvity.ai/a3s/pkgs/version.GitSha=${MINIBRIDGE_COMMIT} \
        -X go.acuvity.ai/a3s/pkgs/version.GitTag=${MINIBRIDGE_VERSION}-jenkins.1" \
      -o /out/minibridge .

FROM ${PYTHON_IMAGE} AS builder
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1
WORKDIR /build
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
RUN python -m pip wheel --wheel-dir=/wheels .

FROM ${PYTHON_IMAGE} AS runtime
ARG APP_VERSION=dev
ARG APP_UID=10001
ARG APP_GID=10001
LABEL org.opencontainers.image.title="Jenkins MCP Server (minibridge)" \
      org.opencontainers.image.description="Jenkins MCP server behind minibridge with Rego guardrails" \
      org.opencontainers.image.source="https://github.com/grglzrv/jenkins-mcp-server" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${APP_VERSION}"

# minibridge resolves an XDG config directory at startup and exits if it
# cannot create one. The pod runs with a read-only root filesystem, so the
# directory is created at build time and pointed at explicitly.
ENV XDG_CONFIG_HOME=/home/app/.config \
    HOME=/home/app \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates tini \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid "${APP_GID}" app \
    && useradd --uid "${APP_UID}" --gid "${APP_GID}" --create-home --shell /usr/sbin/nologin app \
    && mkdir -p /data /certs /home/app/.config/minibridge \
    && chown -R app:app /data /certs /home/app/.config

COPY --from=builder /wheels /wheels
RUN python -m pip install /wheels/*.whl && rm -rf /wheels

COPY --from=minibridge /out/minibridge /usr/bin/minibridge
COPY docker/policy.rego /policy.rego
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod 0555 /entrypoint.sh && chmod 0444 /policy.rego

USER app:app
WORKDIR /home/app

# 8000 = minibridge MCP listener, 8080 = minibridge health.
EXPOSE 8000 8080
VOLUME ["/data"]
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/', timeout=2).read()"]
ENTRYPOINT ["/usr/bin/tini", "--", "/entrypoint.sh"]
