{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "replicaCount",
    "image",
    "serviceAccount",
    "service",
    "ingress",
    "jenkins",
    "mcp",
    "tailscale"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "create",
        "automount"
      ],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "automount": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "port",
        "sessionAffinity"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object"
        },
        "sessionAffinity": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "sessionAffinity"
          ],
          "properties": {
            "sessionAffinity": {
              "type": "string",
              "enum": [
                "None",
                "ClientIP"
              ]
            },
            "sessionAffinityConfig": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "clientIP": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "timeoutSeconds": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 86400
                    }
                  }
                }
              }
            }
          }
        },
        "exposeHealthPort": {
          "type": "boolean",
          "description": "Publish the health listener on the Service. Direct-server /readyz includes configuration and passive Jenkins transport diagnostics; Minibridge exposes its own / health endpoint. Pod probes do not require Service exposure."
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "className",
        "hostname",
        "path",
        "pathType",
        "tls"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "hostname": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "pathType": {
          "type": "string",
          "enum": [
            "Exact",
            "Prefix",
            "ImplementationSpecific"
          ]
        },
        "tls": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object"
        },
        "hostRule": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "tlsSecretName": {
          "type": "string"
        },
        "extraRules": {
          "type": "array"
        }
      }
    },
    "jenkins": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "verifyTls",
        "timeoutSeconds",
        "maxRetries",
        "credentials",
        "caBundle"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^(https?://.+)?$"
        },
        "verifyTls": {
          "type": "boolean"
        },
        "caBundlePath": {
          "type": "string"
        },
        "timeoutSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxRetries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "credentials": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "existingSecret",
            "secretKeyRefs",
            "create",
            "externalSecret"
          ],
          "properties": {
            "existingSecret": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "name": {
                  "type": "string"
                },
                "usernameKey": {
                  "type": "string"
                },
                "tokenKey": {
                  "type": "string"
                }
              }
            },
            "secretKeyRefs": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "username": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "key"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "key": {
                      "type": "string"
                    }
                  }
                },
                "token": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "key"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "key": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "create": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "jenkinsUserId": {
                  "type": "string",
                  "description": "Required when create.enabled is true. Exact value that replaces {0} in Jenkins' configured LDAP User search filter for the account that generated the token. With uid={0}, use the LDAP uid; with a custom filter, use its matching attribute value."
                },
                "jenkinsApiToken": {
                  "type": "string",
                  "description": "Required when create.enabled is true. Jenkins API token generated by the configured Jenkins user ID."
                },
                "JENKINS_USERNAME": {
                  "type": "string",
                  "deprecated": true,
                  "description": "Deprecated 2.2 compatibility field. Use jenkinsUserId."
                },
                "JENKINS_TOKEN": {
                  "type": "string",
                  "deprecated": true,
                  "description": "Deprecated 2.2 compatibility field. Use jenkinsApiToken."
                },
                "username": {
                  "type": "string",
                  "deprecated": true,
                  "description": "Deprecated 2.1 compatibility field. Use jenkinsUserId."
                },
                "token": {
                  "type": "string",
                  "deprecated": true,
                  "description": "Deprecated 2.1 compatibility field. Use jenkinsApiToken."
                },
                "usernameKey": {
                  "type": "string",
                  "minLength": 1,
                  "deprecated": true,
                  "description": "Deprecated compatibility override; chart-managed Secrets use JENKINS_USERNAME by default."
                },
                "tokenKey": {
                  "type": "string",
                  "minLength": 1,
                  "deprecated": true,
                  "description": "Deprecated compatibility override; chart-managed Secrets use JENKINS_TOKEN by default."
                }
              }
            },
            "externalSecret": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "refreshInterval",
                "secretStoreRef",
                "usernameRemoteKey",
                "tokenRemoteKey",
                "apiVersion",
                "secretStore",
                "creationPolicy",
                "deletionPolicy",
                "targetUsernameKey",
                "targetTokenKey"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "refreshInterval": {
                  "type": "string",
                  "minLength": 1
                },
                "secretStoreRef": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "kind"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "SecretStore",
                        "ClusterSecretStore"
                      ]
                    }
                  }
                },
                "usernameRemoteKey": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Required external-provider object name for the Jenkins login/User search-filter ID. Set explicitly when externalSecret.enabled is true."
                },
                "tokenRemoteKey": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Required external-provider object name for the API token generated by the same Jenkins user. Set explicitly when externalSecret.enabled is true."
                },
                "targetUsernameKey": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Required key ESO writes to the target Kubernetes Secret for the Jenkins user ID. Must differ from targetTokenKey."
                },
                "targetTokenKey": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Required key ESO writes to the target Kubernetes Secret for the Jenkins API token. Must differ from targetUsernameKey."
                },
                "apiVersion": {
                  "type": "string",
                  "enum": [
                    "external-secrets.io/v1",
                    "external-secrets.io/v1beta1"
                  ]
                },
                "secretStore": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "create"
                  ],
                  "properties": {
                    "create": {
                      "type": "boolean"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "SecretStore",
                        "ClusterSecretStore"
                      ]
                    },
                    "annotations": {
                      "type": "object"
                    },
                    "conditions": {
                      "type": "array"
                    },
                    "provider": {
                      "type": "object"
                    }
                  }
                },
                "creationPolicy": {
                  "type": "string",
                  "enum": [
                    "Owner",
                    "Orphan",
                    "Merge",
                    "None",
                    "CreateOrMerge"
                  ]
                },
                "deletionPolicy": {
                  "type": "string",
                  "enum": [
                    "Retain",
                    "Delete",
                    "Merge"
                  ]
                },
                "annotations": {
                  "type": "object"
                },
                "usernameRemoteProperty": {
                  "type": "string"
                },
                "tokenRemoteProperty": {
                  "type": "string"
                },
                "remoteVersion": {
                  "type": "string"
                },
                "extraData": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "secretKey"
                    ],
                    "properties": {
                      "secretKey": {
                        "type": "string",
                        "minLength": 1
                      },
                      "remoteRef": {
                        "type": "object"
                      },
                      "sourceRef": {
                        "type": "object"
                      }
                    }
                  }
                },
                "dataFrom": {
                  "type": "array"
                },
                "template": {
                  "type": "object"
                }
              }
            }
          }
        },
        "caBundle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "existingSecret",
            "key"
          ],
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "maxConcurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Maximum Jenkins requests in flight per replica. Excess requests wait up to jenkins.timeoutSeconds for a slot. The cluster-wide ceiling is this value multiplied by the number of replicas."
        }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transport",
        "host",
        "port",
        "path",
        "healthHost",
        "healthPort",
        "healthMaxConnections",
        "readOnly",
        "allowJobWrite",
        "allowBuildWrite",
        "allowNodeWrite",
        "allowAdminRequest",
        "allowScriptConsole",
        "allowedJobs",
        "redactParameterPatterns",
        "maxRequestTargetBytes",
        "maxRequestBytes",
        "maxResponseBytes",
        "maxLogBytes",
        "allowDestructive",
        "allowJobDelete",
        "allowJobUpdate",
        "allowBuildStop"
      ],
      "properties": {
        "transport": {
          "type": "string",
          "enum": [
            "streamable-http"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "healthHost": {
          "type": "string",
          "minLength": 1
        },
        "healthPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "healthMaxConnections": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024,
          "description": "Maximum concurrent direct-server health connections. Slots are reserved before handler threads are created; incomplete requests time out after five seconds."
        },
        "readOnly": {
          "type": "boolean"
        },
        "allowJobWrite": {
          "type": "boolean"
        },
        "allowBuildWrite": {
          "type": "boolean"
        },
        "allowNodeWrite": {
          "type": "boolean"
        },
        "allowAdminRequest": {
          "type": "boolean"
        },
        "allowedJobs": {
          "type": "string"
        },
        "redactParameterPatterns": {
          "type": "array",
          "uniqueItems": true,
          "description": "Additional case-insensitive glob patterns for build parameter names whose values get_build_info redacts. Built-in password, token, secret, credential, and private-key detection remains active.",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 100
        },
        "maxResponseBytes": {
          "type": "integer",
          "minimum": 1024
        },
        "maxLogBytes": {
          "type": "integer",
          "minimum": 1024
        },
        "extraEnv": {
          "type": "array",
          "description": "Additional container environment variables such as HTTP_PROXY. Names are case-sensitive. Chart-owned JENKINS_*, MCP_*, MINIBRIDGE_*, OTEL, and Minibridge policy/auth variables are rejected in any capitalisation; use their typed values instead.",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "allowDestructive": {
          "type": "boolean"
        },
        "allowJobDelete": {
          "type": "boolean"
        },
        "allowJobUpdate": {
          "type": "boolean"
        },
        "allowBuildStop": {
          "type": "boolean"
        },
        "allowScriptConsole": {
          "type": "boolean",
          "description": "Additional in-process opt-in for the Jenkins Groovy script console. Requires allowAdminRequest too. Minibridge sensitive-pattern-detection independently refuses script-console paths when active."
        },
        "maxRequestBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 100000000,
          "description": "Maximum encoded request-body bytes sent to Jenkins. Enforced before any controller or CSRF-crumb request."
        },
        "maxRequestTargetBytes": {
          "type": "integer",
          "minimum": 256,
          "maximum": 65536,
          "description": "Maximum encoded HTTP request-target bytes sent to Jenkins, including the configured context path and query string. Enforced before any controller or CSRF-crumb request."
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "maxUnavailable": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "allowSameNamespace",
        "allowInternetEgress"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allowSameNamespace": {
          "type": "boolean"
        },
        "allowInternetEgress": {
          "type": "boolean"
        },
        "additionalIngress": {
          "type": "array"
        },
        "additionalEgress": {
          "type": "array"
        },
        "allowedNamespaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "tailscale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "magicDNS",
        "egress",
        "proxyGroups",
        "enabled"
      ],
      "properties": {
        "magicDNS": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "createDNSConfig",
            "name"
          ],
          "properties": {
            "createDNSConfig": {
              "type": "boolean"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "serviceName",
            "tailnetFQDN",
            "proxyGroup",
            "port"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "serviceName": {
              "type": "string",
              "minLength": 1
            },
            "tailnetFQDN": {
              "type": "string",
              "pattern": "^([A-Za-z0-9.-]+\\.ts\\.net)?$"
            },
            "proxyGroup": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "proxyGroups": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "create",
            "ingress",
            "egress"
          ],
          "properties": {
            "create": {
              "type": "boolean"
            },
            "ingress": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "replicas",
                "hostnamePrefix"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "replicas": {
                  "type": "integer",
                  "minimum": 1
                },
                "hostnamePrefix": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,61}$"
                }
              }
            },
            "egress": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "replicas",
                "hostnamePrefix"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "replicas": {
                  "type": "integer",
                  "minimum": 1
                },
                "hostnamePrefix": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,61}$"
                }
              }
            }
          }
        },
        "enabled": {
          "type": "boolean"
        },
        "namespace": {
          "type": "string"
        }
      }
    },
    "minibridge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "tagSuffix": {
              "type": "string"
            }
          }
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "healthPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "guardrails": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "covert-instruction-detection",
              "schema-misuse-prevention",
              "secrets-redaction",
              "cross-origin-tool-access",
              "sensitive-pattern-detection",
              "shadowing-pattern-detection"
            ]
          }
        },
        "basicAuth": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "existingSecret": {
              "type": "string"
            },
            "secretKey": {
              "type": "string"
            }
          }
        },
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "deny": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "allow": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "methodsDeny": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mode": {
          "type": "string",
          "enum": [
            "http",
            "websocket"
          ]
        },
        "log": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "level": {
              "type": "string",
              "enum": [
                "debug",
                "info",
                "warn",
                "error"
              ]
            }
          }
        },
        "tracing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string"
            }
          }
        },
        "sbom": {
          "type": "boolean"
        },
        "mcp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "useTempDir"
          ],
          "properties": {
            "useTempDir": {
              "type": "boolean"
            }
          }
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "existingSecret": {
              "type": "string"
            },
            "certKey": {
              "type": "string"
            },
            "keyKey": {
              "type": "string"
            },
            "passSecretKey": {
              "type": "string"
            },
            "pass": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "valueFrom"
              ],
              "properties": {
                "valueFrom": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "key"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "key": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "clientCASecretKey": {
              "type": "string"
            }
          }
        },
        "policer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enforce"
          ],
          "properties": {
            "enforce": {
              "type": "boolean"
            },
            "rego": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "policy": {
                  "type": "string"
                }
              }
            },
            "http": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "url": {
                  "type": "string"
                },
                "caPath": {
                  "type": "string"
                },
                "token": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "existingSecret": {
                      "type": "string"
                    },
                    "secretKey": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "revisionHistoryLimit": {
      "type": "integer",
      "minimum": 0
    },
    "autoscaling": {
      "type": "object",
