{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "replicaCount",
    "image",
    "serviceAccount",
    "service",
    "ingress",
    "jenkins",
    "mcp",
    "tailscale"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "serviceAccount": {
      "type": "object",
      "required": [
        "create",
        "automount"
      ],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "automount": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "service": {
      "type": "object",
      "required": [
        "type",
        "port",
        "sessionAffinity"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer",
            "ExternalName"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object"
        },
        "sessionAffinity": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "sessionAffinity"
          ],
          "properties": {
            "sessionAffinity": {
              "type": "string",
              "enum": [
                "None",
                "ClientIP"
              ]
            },
            "sessionAffinityConfig": {
              "type": "object",
              "properties": {
                "clientIP": {
                  "type": "object",
                  "properties": {
                    "timeoutSeconds": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 86400
                    }
                  }
                }
              }
            }
          }
        },
        "exposeHealthPort": {
          "type": "boolean"
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": [
        "enabled",
        "className",
        "hostname",
        "path",
        "pathType",
        "tls"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "hostname": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "pathType": {
          "type": "string",
          "enum": [
            "Exact",
            "Prefix",
            "ImplementationSpecific"
          ]
        },
        "tls": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object"
        },
        "hostRule": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "tlsSecretName": {
          "type": "string"
        },
        "extraRules": {
          "type": "array"
        }
      }
    },
    "jenkins": {
      "type": "object",
      "required": [
        "url",
        "verifyTls",
        "timeoutSeconds",
        "maxRetries",
        "credentials",
        "caBundle"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^(https?://.+)?$"
        },
        "verifyTls": {
          "type": "boolean"
        },
        "caBundlePath": {
          "type": "string"
        },
        "timeoutSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxRetries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "credentials": {
          "type": "object",
          "required": [
            "existingSecret",
            "secretKeyRefs",
            "create",
            "externalSecret"
          ],
          "properties": {
            "existingSecret": {
              "type": "object",
              "required": [
                "enabled"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "name": {
                  "type": "string"
                },
                "usernameKey": {
                  "type": "string"
                },
                "tokenKey": {
                  "type": "string"
                }
              }
            },
            "secretKeyRefs": {
              "type": "object",
              "required": [
                "enabled"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "username": {
                  "type": "object",
                  "required": [
                    "name",
                    "key"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "key": {
                      "type": "string"
                    }
                  }
                },
                "token": {
                  "type": "object",
                  "required": [
                    "name",
                    "key"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "key": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "create": {
              "type": "object",
              "required": [
                "enabled"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "username": {
                  "type": "string"
                },
                "token": {
                  "type": "string"
                }
              }
            },
            "externalSecret": {
              "type": "object",
              "required": [
                "enabled",
                "refreshInterval",
                "secretStoreRef",
                "usernameRemoteKey",
                "tokenRemoteKey",
                "apiVersion",
                "secretStore",
                "creationPolicy",
                "deletionPolicy"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "refreshInterval": {
                  "type": "string",
                  "minLength": 1
                },
                "secretStoreRef": {
                  "type": "object",
                  "required": [
                    "name",
                    "kind"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "kind": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "usernameRemoteKey": {
                  "type": "string",
                  "minLength": 1
                },
                "tokenRemoteKey": {
                  "type": "string",
                  "minLength": 1
                },
                "apiVersion": {
                  "type": "string",
                  "enum": [
                    "external-secrets.io/v1",
                    "external-secrets.io/v1beta1"
                  ]
                },
                "secretStore": {
                  "type": "object",
                  "required": [
                    "create"
                  ],
                  "properties": {
                    "create": {
                      "type": "boolean"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "SecretStore",
                        "ClusterSecretStore"
                      ]
                    },
                    "annotations": {
                      "type": "object"
                    },
                    "conditions": {
                      "type": "array"
                    },
                    "provider": {
                      "type": "object"
                    }
                  }
                },
                "creationPolicy": {
                  "type": "string",
                  "enum": [
                    "Owner",
                    "Orphan",
                    "Merge",
                    "None"
                  ]
                },
                "deletionPolicy": {
                  "type": "string",
                  "enum": [
                    "Retain",
                    "Delete",
                    "Merge"
                  ]
                },
                "annotations": {
                  "type": "object"
                },
                "usernameRemoteProperty": {
                  "type": "string"
                },
                "tokenRemoteProperty": {
                  "type": "string"
                },
                "remoteVersion": {
                  "type": "string"
                },
                "extraData": {
                  "type": "array"
                },
                "dataFrom": {
                  "type": "array"
                },
                "template": {
                  "type": "object"
                }
              }
            }
          }
        },
        "caBundle": {
          "type": "object",
          "required": [
            "existingSecret",
            "key"
          ],
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "mcp": {
      "type": "object",
      "required": [
        "transport",
        "host",
        "port",
        "path",
        "healthHost",
        "healthPort",
        "readOnly",
        "allowJobWrite",
        "allowBuildWrite",
        "allowNodeWrite",
        "allowAdminRequest",
        "allowedJobs",
        "maxLogBytes",
        "allowDestructive",
        "allowJobDelete",
        "allowJobUpdate",
        "allowBuildStop"
      ],
      "properties": {
        "transport": {
          "type": "string",
          "enum": [
            "streamable-http"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "healthHost": {
          "type": "string",
          "minLength": 1
        },
        "healthPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "readOnly": {
          "type": "boolean"
        },
        "allowJobWrite": {
          "type": "boolean"
        },
        "allowBuildWrite": {
          "type": "boolean"
        },
        "allowNodeWrite": {
          "type": "boolean"
        },
        "allowAdminRequest": {
          "type": "boolean"
        },
        "allowedJobs": {
          "type": "string"
        },
        "maxLogBytes": {
          "type": "integer",
          "minimum": 1024
        },
        "extraEnv": {
          "type": "array"
        },
        "allowDestructive": {
          "type": "boolean"
        },
        "allowJobDelete": {
          "type": "boolean"
        },
        "allowJobUpdate": {
          "type": "boolean"
        },
        "allowBuildStop": {
          "type": "boolean"
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "maxUnavailable": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": [
        "enabled",
        "allowInternetEgress"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allowInternetEgress": {
          "type": "boolean"
        },
        "additionalIngress": {
          "type": "array"
        },
        "additionalEgress": {
          "type": "array"
        },
        "allowedNamespaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "tailscale": {
      "type": "object",
      "required": [
        "magicDNS",
        "egress",
        "proxyGroups",
        "enabled"
      ],
      "properties": {
        "magicDNS": {
          "type": "object",
          "required": [
            "createDNSConfig",
            "name"
          ],
          "properties": {
            "createDNSConfig": {
              "type": "boolean"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "egress": {
          "type": "object",
          "required": [
            "enabled",
            "serviceName",
            "tailnetFQDN",
            "proxyGroup",
            "port"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "serviceName": {
              "type": "string",
              "minLength": 1
            },
            "tailnetFQDN": {
              "type": "string",
              "pattern": "^([A-Za-z0-9.-]+\\.ts\\.net)?$"
            },
            "proxyGroup": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "proxyGroups": {
          "type": "object",
          "required": [
            "create",
            "ingress",
            "egress"
          ],
          "properties": {
            "create": {
              "type": "boolean"
            },
            "ingress": {
              "type": "object",
              "required": [
                "name",
                "replicas",
                "hostnamePrefix"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "replicas": {
                  "type": "integer",
                  "minimum": 1
                },
                "hostnamePrefix": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "egress": {
              "type": "object",
              "required": [
                "name",
                "replicas",
                "hostnamePrefix"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "replicas": {
                  "type": "integer",
                  "minimum": 1
                },
                "hostnamePrefix": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "enabled": {
          "type": "boolean"
        },
        "namespace": {
          "type": "string"
        }
      }
    },
    "minibridge": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "tagSuffix": {
              "type": "string"
            }
          }
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "healthPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "guardrails": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "covert-instruction-detection",
              "schema-misuse-prevention",
              "secrets-redaction",
              "cross-origin-tool-access",
              "sensitive-pattern-detection",
              "shadowing-pattern-detection"
            ]
          }
        },
        "basicAuth": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "existingSecret": {
              "type": "string"
            },
            "secretKey": {
              "type": "string"
            }
          }
        },
        "tools": {
          "type": "object",
          "properties": {
            "deny": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "allow": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "methodsDeny": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mode": {
          "type": "string",
          "enum": [
            "http",
            "websocket"
          ]
        },
        "log": {
          "type": "object",
          "properties": {
            "level": {
              "type": "string",
              "enum": [
                "debug",
                "info",
                "warn",
                "error"
              ]
            }
          }
        },
        "tracing": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            }
          }
        },
        "sbom": {
          "type": "boolean"
        },
        "mcp": {
          "type": "object",
          "required": [
            "useTempDir"
          ],
          "properties": {
            "useTempDir": {
              "type": "boolean"
            }
          }
        },
        "tls": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "existingSecret": {
              "type": "string"
            },
            "certKey": {
              "type": "string"
            },
            "keyKey": {
              "type": "string"
            },
            "passSecretKey": {
              "type": "string"
            },
            "pass": {
              "type": "object",
              "required": [
                "valueFrom"
              ],
              "properties": {
                "valueFrom": {
                  "type": "object",
                  "required": [
                    "name",
                    "key"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "key": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "clientCASecretKey": {
              "type": "string"
            }
          }
        },
        "policer": {
          "type": "object",
          "required": [
            "enforce"
          ],
          "properties": {
            "enforce": {
              "type": "boolean"
            },
            "rego": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "policy": {
                  "type": "string"
                }
              }
            },
            "http": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "url": {
                  "type": "string"
                },
                "caPath": {
                  "type": "string"
                },
                "token": {
                  "type": "object",
                  "properties": {
                    "existingSecret": {
                      "type": "string"
                    },
                    "secretKey": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "revisionHistoryLimit": {
      "type": "integer",
      "minimum": 0
    },
    "autoscaling": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100
        },
        "targetMemoryUtilizationPercentage": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100
        },
        "extraMetrics": {
          "type": "array"
        },
        "behavior": {
          "type": "object"
        }
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "object"
        },
        "limits": {
          "type": "object"
        }
      }
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": "array"
    },
    "priorityClassName": {
      "type": "string"
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "extraVolumes": {
      "type": "array"
    },
    "extraVolumeMounts": {
      "type": "array"
    },
    "probes": {
      "type": "object"
    },
    "audit": {
      "type": "object",
      "properties": {
        "fileEnabled": {
          "type": "boolean"
        },
        "path": {
          "type": "string"
        },
        "storage": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "emptyDir",
                "pvc"
              ]
            },
            "emptyDir": {
              "type": "object"
            },
            "persistentVolumeClaim": {
              "type": "object",
              "properties": {
                "claimName": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "global": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
