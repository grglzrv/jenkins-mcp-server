      "type": "object",
      "additionalProperties": false,
      "required": [
        "liveness",
        "readiness",
        "startup"
      ],
      "properties": {
        "liveness": {
          "$ref": "#/definitions/probe"
        },
        "readiness": {
          "$ref": "#/definitions/probe"
        },
        "startup": {
          "$ref": "#/definitions/probe"
        }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image"
      ],
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "tag",
            "pullPolicy"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fileEnabled",
        "requiredForReadiness",
        "path",
        "maxFileBytes",
        "backupCount",
        "storage"
      ],
      "properties": {
        "fileEnabled": {
          "type": "boolean",
          "description": "Write a redundant JSONL audit copy to a file in addition to process logs."
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "emptyDir",
                "pvc"
              ]
            },
            "emptyDir": {
              "type": "object",
              "properties": {
                "sizeLimit": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "persistentVolumeClaim": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "claimName": {
                  "type": "string"
                }
              }
            }
          }
        },
        "requiredForReadiness": {
          "type": "boolean",
          "description": "Fail readiness when configured audit file output is unhealthy."
        },
        "maxFileBytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Rotate the active audit file before the next record would exceed this size; zero disables rotation when backupCount is also zero."
        },
        "backupCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Number of rotated audit files to retain; zero disables rotation when maxFileBytes is also zero."
        }
      }
    },
