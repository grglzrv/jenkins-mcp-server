# Application environment-variable names are case-sensitive; keep the exact
# uppercase spellings shown in this file.
JENKINS_URL=https://jenkins.example.com
# Actual value matching {0} in Jenkins' LDAP User search filter (often LDAP uid).
JENKINS_USERNAME=replace-with-actual-jenkins-login-id
JENKINS_TOKEN=replace-me
JENKINS_VERIFY_TLS=true
# Uncomment only when Jenkins uses a private or self-signed CA and place the
# certificate at ./certs/ca.crt for the Compose example.
# JENKINS_CA_BUNDLE=/certs/ca.crt
JENKINS_TIMEOUT_SECONDS=30
# Requests in flight at Jenkins from this replica. Excess requests wait up to
# JENKINS_TIMEOUT_SECONDS for a slot; replicas multiply the deployment total.
JENKINS_MAX_CONCURRENCY=10
JENKINS_MAX_RETRIES=3
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_PATH=/mcp
MCP_HEALTH_HOST=0.0.0.0
MCP_HEALTH_PORT=8081
MCP_READ_ONLY=false
MCP_ALLOW_JOB_WRITE=true
MCP_ALLOW_BUILD_WRITE=true
MCP_ALLOW_NODE_WRITE=false
MCP_ALLOW_ADMIN_REQUEST=false
# The Jenkins script console runs arbitrary code on the controller, which
# is a separate decision from allowing an arbitrary API call. Leave false
# unless you specifically need it.
MCP_ALLOW_SCRIPT_CONSOLE=false
# Destructive (irreversible) actions. MCP_ALLOW_DESTRUCTIVE is the master
# switch; each action also needs its own flag and its category flag above.
MCP_ALLOW_DESTRUCTIVE=false
# Job deletion cannot be undone, so it is opt-in even with job writes enabled.
MCP_ALLOW_JOB_DELETE=false
MCP_ALLOW_JOB_UPDATE=true
# Aborts running builds / cancels queued items. Does not affect triggering.
MCP_ALLOW_BUILD_STOP=true
MCP_ALLOWED_JOBS=*
# Largest encoded body sent to Jenkins. Refused before any controller or crumb
# request; raise it only for a measured legitimate definition or parameter set.
MCP_MAX_REQUEST_BYTES=10000000
MCP_MAX_RESPONSE_BYTES=10000000
MCP_MAX_LOG_BYTES=1000000
# Audit records always go to process logs (stderr for stdio). Optional file
# output can be bounded with size rotation. A write failure is always reported
# by /readyz but gates traffic only when REQUIRED_FOR_READINESS is true.
# MCP_AUDIT_LOG_PATH=/data/audit.jsonl
# MCP_AUDIT_REQUIRED_FOR_READINESS=false
# MCP_AUDIT_MAX_BYTES=52428800
# MCP_AUDIT_BACKUP_COUNT=3
